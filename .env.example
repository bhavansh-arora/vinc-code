# Copy to .env on the server (never commit .env).

# The first VINC admin is created from these on the first start. Remove ADMIN_PASSWORD afterwards.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-long-password

# Email for the contact form (one.com). Port 465 uses SSL; use 587 for STARTTLS.
SMTP_HOST=send.one.com
SMTP_PORT=465
SMTP_USER=info@vinc-lab.com
SMTP_PASS=
MAIL_FROM="VINC Code <info@vinc-lab.com>"
CONTACT_TO=info@vinc-lab.com

# Local development only. In Docker the database lives in the vinc-data volume.
DATABASE_PATH=./data/vinc.db

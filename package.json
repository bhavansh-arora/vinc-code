{
  "name": "vinc-code",
  "version": "0.1.0",
  "private": true,
  "description": "VINC Code: a gamified coding platform for Classes 3 to 8, starring Vinc the robot.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-game.mjs && next build",
    "start": "next start",
    "seed": "node --conditions=react-server --import tsx scripts/seed.mts",
    "check:content": "node --conditions=react-server --import tsx scripts/check-content.mts",
    "typecheck": "tsc --noEmit",
    "predev": "node scripts/build-game.mjs",
    "check:lessons": "node --conditions=react-server --import tsx scripts/check-lessons.mts",
    "voice": "node --conditions=react-server --import tsx scripts/voice-lines.mts > .voice-lines.json && python3 scripts/voice-render.py .voice-lines.json",
    "check:voice": "node --conditions=react-server --import tsx scripts/voice-lines.mts --check"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "^8.5.33"
  }
}
